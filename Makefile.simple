# Makefile.simple — plain-make build of Reynard with no external tooling.
# Intended for BSD ports trees:   make -f Makefile.simple && make -f Makefile.simple install
# CMake remains the primary build; this wrapper just calls the compiler directly.

CC      ?= cc
CFLAGS  ?= -O2 -std=c17 -Wall -Wextra -Wpedantic
CPPFLAGS += -D_POSIX_C_SOURCE=200809L -Iinclude -Isrc

CORE = \
	src/util/scrfmt.c src/util/rptfmt.c src/util/rpp.c src/util/strbuf.c src/util/str.c src/util/utf8.c src/util/cp_tables.c \
	src/util/ddatecnv.c src/util/numeric.c src/util/errlist.c src/util/log.c src/util/cfg.c \
	src/util/sha256.c \
	src/term/term_script.c src/term/mouse.c \
	src/ui/screen.c src/ui/window.c src/ui/getsay.c src/ui/cmdwin.c \
	src/ui/menudef.c src/ui/menubar.c src/ui/statusbar.c src/ui/dialog.c \
	src/ui/helpwin.c src/ui/browse.c src/ui/read.c src/ui/screenb.c src/ui/preview.c src/ui/rptb.c src/ui/ui.c \
	src/data/dbf.c src/data/dbf_create.c src/data/field.c src/data/memo_fpt.c \
	src/data/memo_dbt.c src/data/codepage.c src/data/workarea.c src/data/rlock.c \
	src/data/journal.c src/data/scope.c src/data/copyto.c \
	src/data/cdx.c src/data/idx.c src/data/ntx_read.c \
	src/lang/lexer.c src/lang/parser.c src/lang/expr_compile.c src/lang/vm.c \
	src/lang/cmds_data.c src/lang/cmds_index.c src/lang/cmds_aggr.c src/lang/cmds_form.c src/lang/cmds_screen.c src/lang/cmds_rpt.c src/lang/cmds_menu.c src/lang/cmds_txn.c src/lang/cmds_proj.c src/lang/help.c src/lang/rpt.c src/lang/rpt_emit.c src/lang/picture.c src/lang/cmds_env.c src/lang/memvar.c src/lang/errhand.c \
	src/lang/rxp.c src/lang/funcs_array.c \
	src/lang/funcs_str.c src/lang/funcs_num.c src/lang/funcs_date.c \
	src/lang/funcs_db.c src/lang/funcs_sys.c

# term_ncurses.c is always compiled (self-guarded); headers only add the
# live backend via -DRX_HAVE_NCURSES.
CORE += src/term/term_ncurses.c
# Header probes avoid '#include' in the makefile itself ('#' is a make
# comment); -include pulls the header into an empty translation unit.
# On macOS the system ncurses is narrow-only (5.7); a package-manager
# ncurses is picked up automatically so wide glyphs render natively when
# available — Homebrew (/opt/homebrew, /usr/local) or MacPorts (/opt/local).
# Header layouts differ: ncursesw/curses.h, ncurses/curses.h, flat curses.h.
ifeq ($(shell uname -s 2>/dev/null),Darwin)
    ifneq ($(wildcard /opt/homebrew/opt/ncurses/include/ncursesw/curses.h),)
        CPPFLAGS += -I/opt/homebrew/opt/ncurses/include
        PKG_L := -L/opt/homebrew/opt/ncurses/lib
    else ifneq ($(wildcard /usr/local/opt/ncurses/include/ncursesw/curses.h),)
        CPPFLAGS += -I/usr/local/opt/ncurses/include
        PKG_L := -L/usr/local/opt/ncurses/lib
    else ifneq ($(wildcard /opt/local/include/ncursesw/curses.h),)
        CPPFLAGS += -I/opt/local/include
        PKG_L := -L/opt/local/lib
    else ifneq ($(wildcard /opt/local/include/ncurses/curses.h),)
        CPPFLAGS += -I/opt/local/include -I/opt/local/include/ncurses
        PKG_L := -L/opt/local/lib
    else ifneq ($(wildcard /opt/local/include/curses.h),)
        CPPFLAGS += -I/opt/local/include
        PKG_L := -L/opt/local/lib
    endif
endif
HAVE_CURSES := $(shell $(CC) -x c -fsyntax-only $(CPPFLAGS) -include curses.h /dev/null 2>/dev/null && echo yes)
ifeq ($(HAVE_CURSES),)
HAVE_CURSES := $(shell $(CC) -x c -fsyntax-only $(CPPFLAGS) -include ncurses/curses.h /dev/null 2>/dev/null && echo yes)
endif
HAVE_CURSESW := $(shell $(CC) -x c -fsyntax-only $(CPPFLAGS) -include ncursesw/curses.h /dev/null 2>/dev/null && echo yes)
ifeq ($(HAVE_CURSESW),yes)
CPPFLAGS += -DRX_HAVE_NCURSES=1 -DRX_HAVE_NCURSESW_H=1
LDLIBS := $(PKG_L) -lncursesw $(LDLIBS)
else ifeq ($(HAVE_CURSES),yes)
CPPFLAGS += -DRX_HAVE_NCURSES=1
ifneq ($(wildcard $(patsubst -L%,%,$(PKG_L))/libncursesw.*),)
# flat header layout (MacPorts/BSD) but the wide lib is present: ncurses 6's
# curses.h declares the wide API, so use the wide path via the flat header
CPPFLAGS += -DRX_HAVE_NCURSESW_FLAT=1
LDLIBS := $(PKG_L) -lncursesw $(LDLIBS)
else
LDLIBS += -lncurses
endif
endif
LDLIBS += -lm

all: reynard reynard-harness

# Embed LICENSE for --dump-license (generated like CMake does).
license_text.c: LICENSE
	printf 'const char rx_license_text[] =\n' > $@
	sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e 's/$$/\\n"/' -e 's/^/"/' LICENSE >> $@
	printf ';\n' >> $@

reynard: src/main.c license_text.c $(CORE)
	$(CC) $(CFLAGS) $(CPPFLAGS) -o $@ src/main.c license_text.c $(CORE) $(LDLIBS)

reynard-harness: tests/harness.c license_text.c $(CORE)
	$(CC) $(CFLAGS) $(CPPFLAGS) -o $@ tests/harness.c license_text.c $(CORE) $(LDLIBS)

test: all
	./reynard-harness selftest
	./reynard-harness conformance tests/conformance $(CURDIR)/reynard testdata/gen .test-work
	./reynard-harness roundtrip testdata/gen .test-work
	./reynard-harness rxp tests/rxp $(CURDIR)/reynard testdata/gen .test-work
	./reynard-harness lockrace .test-work
	./reynard-harness golden tests/golden $(CURDIR)/reynard testdata/gen .test-work
	./reynard-harness browseperf .test-work $(CURDIR)/reynard
	./reynard-harness cdx .test-work
	./reynard-harness scrcheck tests/scr .test-work
	./reynard-harness rptcheck tests/rpt $(CURDIR)/reynard testdata/gen .test-work

install: reynard
	install -d $(DESTDIR)/usr/local/bin $(DESTDIR)/usr/local/share/man/man1
	install -m 755 reynard $(DESTDIR)/usr/local/bin/reynard
	install -m 644 docs/man/reynard.1 $(DESTDIR)/usr/local/share/man/man1/reynard.1

# M10 (spec 11.1): API docs via Doxygen; the CI docs job publishes
# build/docs/html to the `docs` branch. Falls back to the cmake target.
docs:
	@if command -v doxygen >/dev/null 2>&1; then \
		doxygen Doxyfile && echo "docs in build/docs/html"; \
	elif [ -d build ]; then \
		cmake --build build --target docs; \
	else \
		echo "install doxygen (or configure cmake in build/) for 'make docs'"; \
		exit 1; \
	fi

clean:
	rm -f reynard reynard-harness license_text.c
	rm -rf .test-work build/docs

.PHONY: all test install clean docs
