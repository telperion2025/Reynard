BasedOnStyle: LLVM
Language: Cpp
IndentWidth: 4
ColumnLimit: 100
BraceWrapping:
  AfterFunction: true
  AfterControlStatement: false
  AfterEnum: false
  AfterStruct: false
PointerAlignment: Left
AllowShortFunctionsOnASingleLine: None
AllowShortIfStatementsOnASingleLine: false
SortIncludes: CaseSensitive
# System/POSIX headers (<...>) sort BEFORE project headers ("..."): glibc
# <unistd.h> redefines R_OK, and reynard/status.h must own R_OK (=0), so the
# include order is load-bearing (see docs/DEVIATIONS.md).
IncludeCategories:
  - Regex: '^<'
    Priority: 1
  - Regex: '^"'
    Priority: 2
