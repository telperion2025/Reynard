USE people
INDEX ON age TAG A
SEEK 30
? FOUND(), TRIM(name)
REPLACE FOR TRIM(name) = "Alice" age WITH 100
SEEK 100
? FOUND(), RECNO(), TRIM(name)
SET EXACT ON
SEEK 30
? FOUND(), EOF()
SET EXACT OFF
APPEND BLANK
REPLACE name WITH "Zed", age WITH 33
SEEK 33
? FOUND(), RECNO(), TRIM(name)
? KEYCOUNT()
REINDEX
? KEYCOUNT()
CLOSE ALL
